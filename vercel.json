{
  "version": 2,
  "builds": [
    {
      "src": "bot/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/bot",
      "dest": "bot/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ]
}
